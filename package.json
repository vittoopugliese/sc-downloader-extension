{
  "name": "sc-downloader-extension",
  "version": "2026.10.5",
  "private": true,
  "description": "SoundCloud downloader browser extension",
  "scripts": {
    "vendor:stems": "node scripts/vendor-stem-runtime.cjs",
    "test:stems": "node --test scripts/stems.test.mjs",
    "test:e2e:stems-ui": "node scripts/stems-ui.browser-test.cjs",
    "test:e2e:stems": "node scripts/stems.browser-test.cjs",
    "test:contact-content": "node scripts/verify-contact-content.js && node scripts/verify-contact-content-runtime.js",
    "test:contact-content:browser": "node scripts/verify-contact-content-browser.js",
    "test": "node scripts/run-verifications.js",
    "test:e2e": "node scripts/verify-loop-browser.js",
    "test:e2e:likes": "node scripts/likes-explorer.browser-test.js",
    "test:e2e:bulk-store": "node scripts/bulk-library.browser-test.js",
    "test:e2e:download": "node scripts/verify-download-browser.js",
    "test:e2e:popup": "node scripts/verify-popup-browser.js && node scripts/verify-popup-offer-loading.js && node scripts/verify-popup-unsupported-page.js",
    "test:e2e:feedback": "node scripts/verify-uninstall-feedback-browser.js",
    "test:e2e:tempo": "node scripts/verify-tempo-browser.js && node scripts/sampler-controls.browser-test.js",
    "test:e2e:waveform": "node scripts/spectral-waveform.browser-test.js && node scripts/spectral-waveform-long.browser-test.js",
    "test:e2e:sampler-persistence": "node scripts/sampler-persistence.browser-test.js",
    "test:e2e:sampler-time": "node scripts/sampler-time.browser-test.js",
    "test:e2e:pad-editor": "node scripts/pad-editor.browser-test.js && node scripts/pad-editor-performance.browser-test.js && node scripts/pad-editor-regressions.browser-test.js",
    "test:e2e:slices": "node scripts/verify-sampler-slices-browser.js",
    "test:e2e:effects": "node scripts/verify-effects-browser.js && node scripts/verify-effects-browser.js --shared && node scripts/verify-effects-browser.js --shared --constructor",
    "test:e2e:eq": "node scripts/verify-parametric-eq-browser.js",
    "test:e2e:record": "node scripts/verify-record-browser.js && node scripts/verify-record-extension-browser.js",
    "test:e2e:licensing": "node scripts/verify-player-tools-browser.js",
    "test:package": "node scripts/verify-package-browser.js",
    "test:release-local": "npm test && npm run test:player-tools && npm run test:e2e:bulk-store && npm run test:e2e:download && npm run test:e2e:popup && npm run test:e2e && npm run test:e2e:tempo && npm run test:e2e:effects && npm run test:e2e:eq && npm run test:e2e:record && npm run test:e2e:likes && npm run package:extension && npm run test:package",
    "test:live": "node scripts/verify-live-looper.js",
    "test:live:folder": "node scripts/verify-live-looper.js --folder",
    "browser:live": "node scripts/open-live-browser.js",
    "test:feedback": "node --test services/uninstall-feedback/test/validation.test.mjs",
    "test:player-tools": "node scripts/verify-player-tools-policy.js && node scripts/verify-player-tools-access.js && node scripts/verify-player-tools-client.js && node scripts/verify-player-tools-commerce.js && npm --prefix services/player-tools-license test",
    "package:extension": "node scripts/package-extension.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "onnxruntime-web": "1.30.0"
  }
}
