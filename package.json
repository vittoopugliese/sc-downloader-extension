{
  "name": "sc-downloader-extension",
  "version": "2026.10.5",
  "private": true,
  "description": "SoundCloud downloader browser extension",
  "scripts": {
    "test:contact-content": "node scripts/verify-contact-content.js && node scripts/verify-contact-content-runtime.js",
    "test:contact-content:browser": "node scripts/verify-contact-content-browser.js",
    "test": "node scripts/run-verifications.js",
    "test:e2e": "node scripts/verify-loop-browser.js",
    "test:e2e:likes": "node scripts/likes-explorer.browser-test.js",
    "test:e2e:bulk-store": "node scripts/bulk-library.browser-test.js",
    "test:e2e:download": "node scripts/verify-download-browser.js",
    "test:e2e:popup": "node scripts/verify-popup-browser.js && node scripts/verify-popup-unsupported-page.js",
    "test:e2e:feedback": "node scripts/verify-uninstall-feedback-browser.js",
    "test:e2e:tempo": "node scripts/verify-tempo-browser.js",
    "test:e2e:effects": "node scripts/verify-effects-browser.js && node scripts/verify-effects-browser.js --shared && node scripts/verify-effects-browser.js --shared --constructor",
    "test:e2e:eq": "node scripts/verify-parametric-eq-browser.js",
    "test:package": "node scripts/verify-package-browser.js",
    "test:live": "node scripts/verify-live-looper.js",
    "test:live:folder": "node scripts/verify-live-looper.js --folder",
    "browser:live": "node scripts/open-live-browser.js",
    "test:feedback": "node --test services/uninstall-feedback/test/validation.test.mjs",
    "test:player-tools": "node scripts/verify-player-tools-policy.js && node scripts/verify-player-tools-access.js && node scripts/verify-player-tools-client.js && node scripts/verify-player-tools-commerce.js && npm --prefix services/player-tools-license test",
    "package:extension": "node scripts/package-extension.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
