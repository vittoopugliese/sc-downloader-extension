{
  "name": "sctd-player-tools-license",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "sctd.vpugliese.online/api/player-tools/*", "zone_name": "vpugliese.online" }],
  "vars": {
    "ALLOWED_ORIGINS": "chrome-extension://ekmbbjdpakacalghjkikfppebgdpoebb,http://localhost:3000",
    "LEMON_STORE_ID": "REPLACE_WITH_LEMON_STORE_ID",
    "LEMON_PRODUCT_ID": "REPLACE_WITH_LEMON_PRODUCT_ID",
    "LEMON_VARIANT_ID": "REPLACE_WITH_LEMON_VARIANT_ID"
  },
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "d1_databases": [{
    "binding": "LICENSE_DB",
    "database_name": "sctd-player-tools",
    "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
