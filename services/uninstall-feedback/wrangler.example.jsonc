{
  "name": "sctd-uninstall-feedback",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [{
    "binding": "FEEDBACK_DB",
    "database_name": "sctd-feedback",
    "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
